{
  "private": true,
  "name": "acro-arena-devvit",
  "version": "4.0.0-alpha.3",
  "type": "module",
  "scripts": {
    "dev": "devvit playtest",
    "build": "vite build",
    "test": "node --experimental-strip-types --test tests/arena.test.ts",
    "test:types": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "deploy": "npm run test && npm run build && devvit upload",
    "test:load": "node --experimental-strip-types tests/load.mjs",
    "test:redis": "node --experimental-strip-types tests/redis-load.mjs",
    "test:redis:sharded": "node --experimental-strip-types tests/redis-sharded-load.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@devvit/start": "0.15.3",
    "@devvit/web": "0.15.3",
    "@hono/node-server": "2.1.6",
    "devvit": "0.15.3",
    "hono": "4.13.17",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "ioredis": "^5.4.2"
  }
}
